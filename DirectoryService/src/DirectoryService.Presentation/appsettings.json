{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "DirectoryService": "Debug"
      }
    }
  },
  "ConnectionStrings": {
    "DataBase": "Server=localhost;Port=5434;Database=directory_service;User Id=postgres;Password=postgres;Include Error Detail=true",
    "Seq": "http://localhost:5341",
    "Redis": "localhost:6379"
  },
  "CleanupInactive": {
    "TriggerTime": "02:00",
    "FrequencyDays": "7",
    "BatchSize": 1000,
    "RetentionDays": 30
  },
  "HybridCache": {
    "Expiration": "00:05:00",
    "LocalCacheExpiration": "00:01:00"
  },
  "AllowedHosts": "*"
}
