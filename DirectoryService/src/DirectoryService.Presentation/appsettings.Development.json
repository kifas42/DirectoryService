{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "DirectoryService": "Debug"
      }
    }
  },
  "ConnectionStrings": {
    "DataBase": "Server=localhost;Port=5434;Database=directory_service;User Id=postgres;Password=postgres;Include Error Detail=true",
    "Seq": "http://seq:5341"
  },
  "CleanupInactive":{
    "TriggerTime": "02:00",
    "FrequencyDays": "7",
    "BatchSize": 1000,
    "RetentionDays": 30
  },
  "AllowedHosts": "*"
}